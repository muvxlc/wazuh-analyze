[Unit]
Description=Next.js Wazuh Dashboard Service
After=network-online.target
Requires=network-online.target

[Service]
Type=simple
User=wazuh-dashboard
Group=wazuh-dashboard
WorkingDirectory=/opt/wazuh-alert-dashboard
EnvironmentFile=/opt/wazuh-alert-dashboard/.env.production
ExecStart=/usr/bin/env npm run start
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
