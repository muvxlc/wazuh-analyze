WAZUH_WEBHOOK_URL=http://localhost:3456/api/integrations/wazuh/alerts
WAZUH_WEBHOOK_SECRET=replace-with-your-long-secure-random-secret
WAZUH_WEBHOOK_CONNECT_TIMEOUT=3
WAZUH_WEBHOOK_READ_TIMEOUT=10
WAZUH_WEBHOOK_MAX_ATTEMPTS=4
WAZUH_WEBHOOK_MAX_BACKOFF=60

# The same variables are used by resync-archive.py.
# Test live sender:
sudo -u wazuh /var/ossec/integrations/custom-analyze /path/to/test-alert.json
# Test archive without sending:
sudo -u wazuh env $(sudo cat /var/ossec/integrations/custom-analyze.env | grep -v '^#' | xargs) /var/ossec/framework/python/bin/python3 /var/ossec/integrations/resync-archive.py --dry-run /path/to/alerts.json
